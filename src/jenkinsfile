pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'Recent NodeJS'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'https://github.com/adityapai64/Harry-Potter-Library'
          ]]
        ])
      }
    }

    stage('Build') {
      steps {
        sh '''
          set -e

          # Always run Chromium with sandbox disabled (required when running as root)
          cat > /usr/local/bin/chromium-no-sandbox <<'EOF'
          #!/bin/sh
          exec /usr/bin/chromium --no-sandbox --disable-setuid-sandbox "$@"
          EOF
          chmod +x /usr/local/bin/chromium-no-sandbox

          export CHROME_BIN=/usr/local/bin/chromium-no-sandbox  

          node -v
          npm -v
          npm ci
          npm test
          npm run lint
          npm run build
        '''
      }
    }

    stage('Archive build artifacts') {
        agent any
        steps {
            sh '''
            echo "Workspace:"
            pwd
            echo "Top-level:"
            ls -la
            echo "Searching for output folders:"
            find . -maxdepth 4 -type d \( -name dist -o -name build \) -print || true
            '''

            // Archive any Angular output no matter whether it's dist/ or dist/<app>/
            archiveArtifacts artifacts: '**/dist/**,**/build/**',
                            fingerprint: true,
                            onlyIfSuccessful: true,
                            allowEmptyArchive: true
        }
    }
  }

  post {
    success { echo "Build succeeded." }
    failure { echo "Build failed." }
  }
}
