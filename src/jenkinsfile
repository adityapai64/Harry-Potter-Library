pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'Recent NodeJS'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'https://github.com/adityapai64/Harry-Potter-Library'
          ]]
        ])
      }
    }

    stage('Build') {
      steps {
        sh '''
          set -e

          # Always run Chromium with sandbox disabled (required when running as root)
          cat > /usr/local/bin/chromium-no-sandbox <<'EOF'
          #!/bin/sh
          exec /usr/bin/chromium --no-sandbox --disable-setuid-sandbox "$@"
          EOF
          chmod +x /usr/local/bin/chromium-no-sandbox

          export CHROME_BIN=/usr/local/bin/chromium-no-sandbox  

          node -v
          npm -v
          npm ci
          npm test
          npm run lint
          npm run build
        '''
      }
    }

    stage('Archive build artifacts') {
        agent any
        steps {
                sh '''
                echo "Workspace:"
                pwd
                echo "Top-level:"
                ls -la
                echo "dist candidates:"
                find . -maxdepth 3 -type d -name dist -print || true
                echo "build candidates:"
                find . -maxdepth 3 -type d -name build -print || true
        '''

                // Archive whichever exists
                script {
                def patterns = ['dist/**', 'dist/*/**', 'build/**', 'build/*/**']
                def matched = false
                for (p in patterns) {
                    def count = sh(script: "ls -1 ${p} >/dev/null 2>&1; echo $?", returnStdout: true).trim()
                    // simpler fallback: just try glob existence via find
                }
                archiveArtifacts artifacts: 'dist/**/*,build/**/*', fingerprint: true, onlyIfSuccessful: true, allowEmptyArchive: true
                }
            }
        }

  }

  post {
    success { echo "Build succeeded." }
    failure { echo "Build failed." }
  }
}
