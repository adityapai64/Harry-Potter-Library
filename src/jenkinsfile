pipeline {
  agent none

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      agent any
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'https://github.com/adityapai64/Harry-Potter-Library'
          ]]
        ])
      }
    }

    stage('Build') {
        agent any
        steps {
            script {
                docker.image('node:20-alpine').inside('-u root:root') {
                    sh '''
                    node -v
                    npm -v
                    npm ci
                    npm test
                    npm run lint
                    npm run build
                    '''
                }   
            }
        }
    }


    stage('Archive build artifacts') {
      agent any
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true, onlyIfSuccessful: true
      }
    }

  post {
    success { echo "Build succeeded." }
    failure { echo "Build failed." }
  }
}
