pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    nodejs 'Recent NodeJS'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'https://github.com/adityapai64/Harry-Potter-Library'
          ]]
        ])
      }
    }

    stage('Build') {
      steps {
        sh '''
          export CHROME_BIN=/usr/bin/chromium  
          node -v
          npm -v
          npm ci
          npm test
          npm run lint
          npm run build
        '''
      }
    }

    stage('Archive build artifacts') {
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true, onlyIfSuccessful: true
      }
    }
  }

  post {
    success { echo "Build succeeded." }
    failure { echo "Build failed." }
  }
}
