pipeline {
  agent none

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      agent any
      steps {
        checkout scm
      }
    }

    stage('Build') {
      agent {
        // Requires Jenkins container to be able to talk to the Docker daemon (step 4).
        docker {
          image 'node:20-alpine'
          // If your build needs git, add it:
          // args '-u root:root'
          reuseNode true
          // Mount workspace automatically by Jenkins' docker plugin
        }
      steps {
        sh '''
          node -v
          npm -v
          npm ci #short for npm clean install
          npm test
          npm run lint

          npm run build
        '''
      }
    }

    stage('Archive build artifacts') {
      agent any
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true, onlyIfSuccessful: true
      }
    }
  }

  post {
    success {
      echo "Build succeeded."
    }
    failure {
      echo "Build failed."
    }
  }
}
